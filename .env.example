# Copy this file to .env and replace every placeholder before starting a
# provider-backed or authenticated runtime. .env is ignored and must remain
# local to the installation.

# Compose derives a project name from the working directory when this is
# unset, which also names this instance's local Docker image
# (${COMPOSE_PROJECT_NAME}-local:development, see compose.yaml). Set this
# explicitly whenever this checkout's directory name could collide with
# another instance's (including on a different drive) -- otherwise building
# one instance's pai-runtime can silently repoint the other's image tag.
COMPOSE_PROJECT_NAME=replace-with-a-name-unique-across-every-instance-on-this-host

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
BRAVE_API_KEY=replace-with-your-brave-api-key-or-leave-empty

PAI_WEB_USERNAME=replace-with-your-local-username
PAI_WEB_PASSWORD=replace-with-at-least-24-printable-ascii-characters
PAI_WEB_PORT=8080

# direct-v6 requires no imported exposure. Reviewed replacement profiles must
# use an operator-created authorization lineage and account for predecessor
# exposure before any provider call.
PAI_CONTEXT_GRAPH_RUNTIME_PROFILE=direct-v6
PAI_CONTEXT_GRAPH_GENERATION_BUDGET_MICROUSD=replace-with-cumulative-budget-in-microusd
PAI_CONTEXT_GRAPH_PRIOR_EXPOSURE_MICROUSD=0
PAI_CONTEXT_GRAPH_BUDGET_AUTHORIZATION_ID=replace-with-local-authorization-lineage-id

# Minimum seconds between this process's own KG provider requests (0-300).
# 0 leaves KG formation unthrottled against live conversation traffic on the
# same provider/model. A persistent instance that formed or is reforming a
# large generation in the background should set a few seconds here, or its
# own KG requests will compete with live chat for the model's rate limit.
PAI_CONTEXT_GRAPH_PROVIDER_MIN_INTERVAL_SECONDS=0

# Minimum seconds between this process's own private/autonomous provider
# requests (0-60) -- curiosity, private briefing, episode review. 0 leaves
# them unthrottled against live conversation on the same provider/model. A
# --mind-loop recursive instance's autonomous cognition alone can exceed the
# account's rate limit for that model and start failing live chat too, not
# just background work. Live chat itself is never paced by this.
PAI_CONVERSATION_PRIVATE_PROVIDER_MIN_INTERVAL_SECONDS=0

# Wall-clock deadline for one provider call, in seconds (1-900). 120 is the
# prior fixed default. A price-sorted or otherwise slow backend can
# genuinely take longer than that to produce a real response rather than
# fail fast; raising this trades a longer visible wait for fewer requests
# cut off mid-flight and retried.
PAI_CONVERSATION_PROVIDER_CALL_TIMEOUT_SECONDS=120

# Copy this file to .env and replace every placeholder before starting a
# provider-backed or authenticated runtime. .env is ignored and must remain
# local to the installation.

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
BRAVE_API_KEY=replace-with-your-brave-api-key-or-leave-empty

PAI_WEB_USERNAME=replace-with-your-local-username
PAI_WEB_PASSWORD=replace-with-at-least-24-printable-ascii-characters
PAI_WEB_PORT=8080

# direct-v6 requires no imported exposure. Reviewed replacement profiles must
# use an operator-created authorization lineage and account for predecessor
# exposure before any provider call.
PAI_CONTEXT_GRAPH_RUNTIME_PROFILE=direct-v6
PAI_CONTEXT_GRAPH_GENERATION_BUDGET_MICROUSD=replace-with-cumulative-budget-in-microusd
PAI_CONTEXT_GRAPH_PRIOR_EXPOSURE_MICROUSD=0
PAI_CONTEXT_GRAPH_BUDGET_AUTHORIZATION_ID=replace-with-local-authorization-lineage-id

    "extension_policy": {
      "proposal_threshold": "An extension is admitted only when a recurring relation cannot be expressed by a core predicate without semantic distortion; extensions are first-class predicates with full type declarations.",
      "required_evidence": "At least two distinct future episodes or a structural necessity in the graph read path.",
      "consolidation_rule": "When an extension's usage stabilizes, it may be promoted to core; when unused across a consolidation window, it is dropped."
    },
    "risks": [
      "related_to may become a catch-all; usage should be monitored and promoted to specific predicates when patterns emerge.",
      "protocol as artifact conflates specification and standard; if protocols become first-class actors in coordination episodes, consider a distinct protocol type.",
      "gap vs concept boundary depends on whether a deficiency is instantiated as an addressable node; ambiguous cases should default to concept until actionable."
    ]
  },

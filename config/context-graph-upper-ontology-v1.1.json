    "entity_types": [
      {
        "name": "person",
        "definition": "A human individual, including the operator and other people; no operator-specific type exists in the core schema.",
        "inclusion_rule": "Any human mentioned as an actor, owner, or relation endpoint.",
        "exclusion_rule": "Non-human actors (see agent) and groups of people (see organization)."
      },
      {
        "name": "agent",
        "definition": "An autonomous or semi-autonomous software actor (assistant, persona, AI agent) that can perform actions, hold goals, or exchange messages.",
        "inclusion_rule": "Named AI assistants, agent personas, harnesses acting as agents.",
        "exclusion_rule": "Humans (person); passive software artifacts (artifact, system)."
      },
      {
        "name": "organization",
        "definition": "A collective human entity such as a company, team, or institution.",
        "inclusion_rule": "Companies, employers, publishers, partner firms.",
        "exclusion_rule": "Individual humans; software systems."
      },
      {
        "name": "animal",
        "definition": "A non-human living creature, typically a pet or companion animal.",
        "inclusion_rule": "Named pets and animals.",
        "exclusion_rule": "Humans and software entities."
      },
      {
        "name": "artifact",
        "definition": "A created, largely static object: document, paper, media, product, repository, protocol specification, tool, or design deliverable.",
        "inclusion_rule": "Anything produced, authored, hosted, shared, or reviewed that is not itself a running system.",
        "exclusion_rule": "Running software systems (system); projects (project); abstract notions (concept)."
      },
      {
        "name": "system",
        "definition": "A running or deployable software/hardware system, harness, platform, or infrastructure component that hosts or executes other software.",
        "inclusion_rule": "Harnesses, pipelines, platforms, deployed software systems.",
        "exclusion_rule": "Documents, repos, protocols as specifications (artifact)."
      },
      {
        "name": "project",
        "definition": "A time-bounded effort with goals and deliverables, possibly spanning systems and artifacts.",
        "inclusion_rule": "Named initiatives, roadmaps, migration efforts.",
        "exclusion_rule": "Ongoing systems; single deliverables (artifact)."
      },
      {
        "name": "concept",
        "definition": "An abstract idea, topic, design concept, method, risk, or problem class referenced in reasoning or discussion.",
        "inclusion_rule": "Design ideas, mechanisms, risks, technical problems, topics.",
        "exclusion_rule": "Concrete created objects (artifact) or medical states (condition)."
      },
      {
        "name": "condition",
        "definition": "A medical or health-related state, trait, or deficiency attributable to a person or animal.",
        "inclusion_rule": "Diagnosed or lifelong conditions, deficiencies.",
        "exclusion_rule": "General topics (concept)."
      },
      {
        "name": "event",
        "definition": "A temporally located occurrence, conversation, trip, or milestone that can be ordered in time.",
        "inclusion_rule": "Trips, sessions, check-ins, deployments, incidents.",
        "exclusion_rule": "Persistent entities; ongoing efforts (project)."
      },
      {
        "name": "gap",
        "definition": "A known deficiency in capability, retrieval, or knowledge that the system or operator has identified and may address.",
        "inclusion_rule": "Retrieval gaps, demonstrated failure modes, known unknowns.",
        "exclusion_rule": "Abstract problem topics without an identified deficiency instance (concept)."
